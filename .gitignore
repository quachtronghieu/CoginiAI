# Local RAG databases and SQLite temporary files
rag-tools/cuisine_v2.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Editors and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
