# ESP32 must reach this LAN IP or domain.
PUBLIC_WS_URL=ws://<PC_LAN_IP>:8000/xiaozhi/v1/
XIAOZHI_DEVICE_TOKEN=
XIAOZHI_INPUT_SAMPLE_RATE=16000
XIAOZHI_SERVER_SAMPLE_RATE=24000
XIAOZHI_FRAME_DURATION_MS=60
TIMEZONE_OFFSET_MINUTES=420

# Local faster-whisper. Run the explicit setup command before first offline use.
ASR_MODEL=small
ASR_LANGUAGE=
ASR_COMPUTE_TYPE=
ASR_LOCAL_FILES_ONLY=true
ASR_HOTWORDS=đậu phộng, lạc, trứng, sữa, tôm, cua, hải sản, dị ứng, đúng rồi, không đúng, Cà Mau, Cần Thơ, Nha Trang, Hải Phòng, Hà Nội, Huế, Đà Nẵng, Khánh Hòa, thành phố Hồ Chí Minh, phở chua, bánh tầm cay
ASR_MIN_RMS=0.0015
ASR_MIN_DURATION_SECONDS=0.15
LANGUAGE_HINT_MIN_PROBABILITY=0.80

# Local Ollama.
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemma3:4b
LLM_NUM_PREDICT=1024
LLM_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=90
AI_PIPELINE_TIMEOUT_SECONDS=120

# filtered: RNNoise feeds VAD/Whisper; raw: raw audio only; shadow: raw drives
# the conversation while both raw and RNNoise are transcribed for comparison.
RNNOISE_ENABLED=false
RNNOISE_ASR_MODE=shadow
# Opt-in local transcripts + bounded raw/filtered audio and JSON records.
VOICE_DIAGNOSTICS_ENABLED=false
VOICE_DIAGNOSTICS_SLOTS=24

# Curated cuisine retrieval (SQLite FTS5 built by rag-tools/cuisine_rag.py).
RAG_ENABLED=false
RAG_DB_PATH=
RAG_TOP_K=3
RAG_STRICT=true
# Only real ingredient/cross-contact records confirmed by restaurant staff.
VERIFIED_MENU_PATH=data/verified-menu.json
VERIFIED_MENU_MAX_AGE_DAYS=30

# Local bilingual Piper voices. Matching .onnx.json files use the same basename.
TTS_MODEL_VI=
TTS_MODEL_EN=
TTS_DEFAULT_LANGUAGE=vi

# Legacy single-voice mode. Leave unset when bilingual models are configured.
# TTS_MODEL=
# TTS_VOICE=

MODEL_DEVICE=auto

# Silero model ships with silero-vad; timeout remains a safety limit.
VAD_ENABLED=true
VAD_THRESHOLD=0.4
VAD_STRONG_SPEECH_MS=250
ASR_NO_SPEECH_GATE_PROBABILITY=0.60
VAD_MIN_SILENCE_MS=500
VAD_SPEECH_PAD_MS=200

MAX_AUDIO_SECONDS=30
MAX_AUDIO_BYTES=2097152
AUTO_STOP_TIMEOUT_SECONDS=4
HELLO_TIMEOUT_SECONDS=10
