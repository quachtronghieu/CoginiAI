# ESP32 must reach this LAN IP or domain.
PUBLIC_WS_URL=ws://<PC_LAN_IP>:8000/xiaozhi/v1/
XIAOZHI_DEVICE_TOKEN=
XIAOZHI_INPUT_SAMPLE_RATE=16000
XIAOZHI_SERVER_SAMPLE_RATE=24000
XIAOZHI_FRAME_DURATION_MS=60
TIMEZONE_OFFSET_MINUTES=420

# Local faster-whisper. Run the explicit setup command before first offline use.
ASR_MODEL=small
ASR_LANGUAGE=vi
ASR_COMPUTE_TYPE=
ASR_LOCAL_FILES_ONLY=true
ASR_HOTWORDS=xin chào, chào bạn, cảm ơn, tạm biệt, đúng rồi, chính xác, không đúng, sai rồi, đồng ý, lặp lại, tư vấn món, gợi ý món, ăn sáng, ăn trưa, ăn tối, ăn đêm, ăn vặt, món ngon, đặc sản, hương vị, nguyên liệu, gia vị, cách nấu, công thức, thực đơn, nhà hàng, quán ăn, dị ứng, dị ứng thực phẩm, dị ứng hải sản, dị ứng đậu phộng, dị ứng sữa, dị ứng trứng, không ăn được, kiêng khem, không chứa, không có, hải sản có vỏ, hạt cây, đậu phộng, lạc, trứng gà, trứng vịt, trứng cút, sữa tươi, phô mai, bơ sữa, tôm sú, tôm hùm, cua đồng, cua biển, cua Cà Mau, ghẹ rang me, cá lóc, cá kèo, cá hồi, cá bớp, mực nướng sa tế, bạch tuộc, nghêu hấp sả, sò huyết, ốc móng tay, hàu nướng mỡ hành, thịt bò, thịt heo, thịt gà, thịt vịt, thịt dê, sườn nướng, chân gà sả tắc, sả tắc, phở bò, phở gà, phở tái, phở nạm, phở gầu, phở sốt vang, phở cuốn, phở chua, bún chả, bún thang, bún riêu cua, bún ốc, bún đậu mắm tôm, bún cá rô, bún mọc, bún bò Huế, bún mắm, bún kèn, bún chả cá, bún thịt nướng, bún bì, cơm tấm, cơm tấm sườn bì chả, cơm lam, cơm gà Tam Kỳ, cơm gà Hội An, cơm hến, bánh mì kẹp thịt, bánh mì chảo, bánh mì cay, bánh xèo, bánh xèo củ hũ dừa, bánh khọt, bánh cuốn, bánh bèo, bánh nậm, bánh bột lọc, bánh tét, bánh chưng, bánh pía, bánh tầm cay, bánh tầm bì, bánh đa cua, bánh canh ghẹ, bánh canh chả cá, bánh canh cá lóc, hủ tiếu Nam Vang, hủ tiếu Sa Đéc, hủ tiếu Mỹ Tho, mì Quảng, cao lầu, miến lươn, miến măng gà, cháo lòng, cháo sườn, cháo ếch, xôi xéo, xôi khúc, xôi vò, gỏi cuốn, nem rán, nem lụi, chả ram tôm đất, chả cá Lã Vọng, chả mực Hạ Long, súp cua, lẩu thái, lẩu cua đồng, lẩu mắm, lẩu cá kèo, lẩu gà lá é, bò bít tết, bò kho, bò né, bò sốt vang, chè bưởi, chè thái, cà phê sữa đá, bạc xỉu, trà tắc, trà sen, nước mắm, mắm tôm, mắm nêm, mắm ruốc, củ hũ dừa, hoa chuối, rau răm, ngò gai, tía tô, lá é, bông điên điển, măng chua, sả, gừng, tỏi, ớt hiểm, tiêu lốt, hạt dổi, mắc khén, Hà Nội, Hải Phòng, Quảng Ninh, Lạng Sơn, Sa Pa, Lào Cai, Hà Giang, Cao Bằng, Ninh Bình, Thanh Hóa, Nghệ An, Hà Tĩnh, Huế, Đà Nẵng, Hội An, Quy Nhơn, Quảng Nam, Bình Định, Phú Yên, Nha Trang, Khánh Hòa, Phan Thiết, Bình Thuận, Đà Lạt, Lâm Đồng, Buôn Ma Thuột, Đắk Lắk, TP Hồ Chí Minh, Sài Gòn, Vũng Tàu, Tây Ninh, Đồng Nai, Bình Dương, Long An, Tiền Giang, Mỹ Tho, Bến Tre, Đồng Tháp, Sa Đéc, Vĩnh Long, Trà Vinh, Cần Thơ, Hậu Giang, Sóc Trăng, Bạc Liêu, Cà Mau, An Giang, Châu Đốc, Long Xuyên, Kiên Giang, Rạch Giá, Phú Quốc, ở Đà Lạt, tại Đà Lạt, món ăn Đà Lạt, đặc sản Đà Lạt, ở Cà Mau, tại Cà Mau, món ăn Cà Mau, đặc sản Cà Mau
ASR_MIN_RMS=0.0015
ASR_MIN_DURATION_SECONDS=0.15
LANGUAGE_HINT_MIN_PROBABILITY=0.80

# Local Ollama.
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemma3:4b
LLM_NUM_PREDICT=1024
LLM_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=90
AI_PIPELINE_TIMEOUT_SECONDS=120

# filtered: RNNoise feeds VAD/Whisper; raw: raw audio only; shadow: raw drives
# the conversation while both raw and RNNoise are transcribed for comparison.
RNNOISE_ENABLED=false
RNNOISE_ASR_MODE=shadow
# Opt-in local transcripts + bounded raw/filtered audio and JSON records.
VOICE_DIAGNOSTICS_ENABLED=false
VOICE_DIAGNOSTICS_SLOTS=24

# Curated cuisine retrieval (SQLite FTS5 built by rag-tools/cuisine_rag.py).
RAG_ENABLED=false
RAG_DB_PATH=
RAG_TOP_K=3
RAG_STRICT=true
# Only real ingredient/cross-contact records confirmed by restaurant staff.
VERIFIED_MENU_PATH=data/verified-menu.json
VERIFIED_MENU_MAX_AGE_DAYS=30

# Local bilingual Piper voices. Matching .onnx.json files use the same basename.
TTS_MODEL_VI=
TTS_MODEL_EN=
TTS_DEFAULT_LANGUAGE=vi

# Legacy single-voice mode. Leave unset when bilingual models are configured.
# TTS_MODEL=
# TTS_VOICE=

MODEL_DEVICE=auto

# Silero model ships with silero-vad; timeout remains a safety limit.
VAD_ENABLED=true
VAD_THRESHOLD=0.38
VAD_STRONG_SPEECH_MS=180
ASR_NO_SPEECH_GATE_PROBABILITY=0.70
VAD_MIN_SILENCE_MS=500
VAD_SPEECH_PAD_MS=200

MAX_AUDIO_SECONDS=30
MAX_AUDIO_BYTES=2097152
AUTO_STOP_TIMEOUT_SECONDS=4
HELLO_TIMEOUT_SECONDS=10
